    </placeableSpecializations>

    <placeableTypes>
        <!-- Depot: walk-in building with settings dialog and storage management -->
        <type name="fertilizerDepotType"
              parent="simplePlaceable"
              filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="fertilizerDepot"/>
        </type>
        <!-- Silo: vehicle drive-up filling station for pre-ordered fill types -->
        <type name="fertilizerSiloType"
              parent="simplePlaceable"
              filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="fertilizerSilo"/>
        </type>
        <!-- Pickup zone: place near the in-game shop as the supplier pickup point for deliveries -->
        <type name="fertilizerDepotPickupType"
              parent="simplePlaceable"
              filename="$dataS/scripts/placeables/Placeable.lua">
            <specialization name="fertilizerDepotPickup"/>
        </type>
    </placeableTypes>

    <storeItems>
