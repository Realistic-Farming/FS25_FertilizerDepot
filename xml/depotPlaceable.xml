<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    depotPlaceable.xml
    Fertilizer Depot store building. Uses the base-game mapUS/storage warehouse
    (a proper agri-supply store, not the farmers market). The storage asset
    carries the single clear/level/paint/indoor/test/tipOcclusion area set the
    placeable needs; the mod's own functional nodes map onto the warehouse:
      playerTrigger      -> infoTrigger (0>7, the walk-in door)
      unloadTrigger      -> testAreaEnd01 (0>4|0|0, front vehicle zone)
      productSpawnMarker -> props (0>8|0, interior product spawn)
    The farmers-market gate/door animations do not exist on this asset and are
    removed.
-->
<placeable type="fertilizerDepotType">

    <storeData>
        <name>$l10n_fd_shop_name</name>
        <functions>
            <function>$l10n_fd_shop_function</function>
        </functions>
        <image>icon.dds</image>
        <price>25000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/placeables/mapUS/storage/storage.i3d</filename>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01"/>
        </testAreas>
        <sounds>
            <place template="medImp" pitchScale="1.6"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01"
                   heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="5" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01"
                       heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01"
                       heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01"
                                endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <lights>
        <lightShape node="interior" groupIndex="1"/>
        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsLow" groupIndex="1"/>
            </high>
        </realLights>
        <group name="$l10n_action_placeableLightShed" activateTime="17:30" deactivateTime="8:20"/>
    </lights>

    <!-- Player dialog trigger at the walk-in door; vehicle unload + product
         spawn zones anchored on the warehouse front and interior. -->
    <fertilizerDepot playerTrigger="infoTrigger" unloadTrigger="unloadTriggerMarker" productSpawnMarker="palletTrigger"/>

    <!-- Map hotspot anchored at the front vehicle zone -->
    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker"/>
    </hotspots>

    <!-- In-world markers -->
    <triggerMarkers>
        <!-- Vehicle/trailer zone: park here to buy or sell -->
        <triggerMarker node="unloadTriggerMarker"
                       filename="$data/shared/assets/marker/markerIconLoad.i3d"
                       adjustToGround="true"/>
        <!-- Product output zone: bags/tanks spawn here -->
        <triggerMarker node="palletTrigger"
                       filename="$data/shared/assets/marker/markerIconPallet.i3d"
                       adjustToGround="true"/>
        <triggerMarker node="infoTrigger"
                       filename="$data/shared/assets/marker/markerIconWrench.i3d"
                       adjustToGround="true"/>
    </triggerMarkers>

    <i3dMappings>
        <!-- Clear / level / paint areas (storage asset) -->
        <i3dMapping id="clearAreaStart01"  node="0>0|0"/>
        <i3dMapping id="clearAreaWidth01"  node="0>0|0|0"/>
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1"/>

        <i3dMapping id="levelAreaStart01"  node="0>1|0"/>
        <i3dMapping id="levelAreaWidth01"  node="0>1|0|0"/>
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1"/>

        <i3dMapping id="paintAreaStart01"  node="0>2|0"/>
        <i3dMapping id="paintAreaWidth01"  node="0>2|0|0"/>
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1"/>

        <!-- Indoor area -->
        <i3dMapping id="indoorAreaStart01"  node="0>3|0"/>
        <i3dMapping id="indoorAreaWidth01"  node="0>3|0|0"/>
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1"/>

        <!-- Test areas -->
        <i3dMapping id="testAreaStart01" node="0>4|0"/>
        <i3dMapping id="testAreaEnd01"   node="0>4|0|0"/>

        <!-- Tip occlusion -->
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0"/>
        <i3dMapping id="tipOcclusionUpdateAreaEnd01"   node="0>5|0|0"/>

        <!-- Lights -->
        <i3dMapping id="realLightsLow" node="0>6|0|0"/>
        <i3dMapping id="interior"      node="0>6|0|1|0"/>

        <!-- Functional nodes (mod's own) -->
        <i3dMapping id="infoTrigger"          node="0>7"/>
        <i3dMapping id="unloadTriggerMarker"  node="0>4|0|0"/>
        <i3dMapping id="palletTrigger"        node="0>8|0"/>
    </i3dMappings>

</placeable>
