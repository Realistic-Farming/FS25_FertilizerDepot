<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    depotPlaceable.xml
    Fertilizer Depot store building. Uses the vendored industrial fertilizer
    production hall (i3d/fertilizerProduction_chem.i3d) as the storefront.
    The hall carries the real functional nodes the mod needs:
      playerTrigger      -> playerTriggerMarker (0>16|0|0, the shop entrance)
      unloadTrigger      -> unloadTriggerMarkerFertilizer (0>13|1|3, vehicle unload zone)
      productSpawnMarker -> palletSpawner (0>18, product output zone)
    The hall's dynamic parts (metal hall props, solar panels, bag silos, silo
    bridge) are included; the pack's production chains, fill types, selling
    stations and trailers are not part of the depot.
-->
<placeable type="fertilizerDepotType">

    <storeData>
        <name>$l10n_fd_shop_name</name>
        <functions>
            <function>$l10n_fd_shop_function</function>
        </functions>
        <image>icon.dds</image>
        <price>25000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/fertilizerProduction_chem.i3d</filename>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01"/>
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01"
                   heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="0" maxSlope="100" maxEdgeAngle="100">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01"
                       heightNode="levelAreaHeight01"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01"
                       heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01"
                                endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <!-- The hall's own dynamic parts: metal hall props, solar panels, bag silos, silo bridge -->
    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="i3d/metalHall_props.i3d"  node="0" linkNode="props"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d"      node="0" linkNode="solar1"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d"      node="0" linkNode="solar2"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d"      node="0" linkNode="solar3"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d"      node="0" linkNode="solar4"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d"      node="0" linkNode="solar5"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d"      node="0" linkNode="solar6"/>
        <dynamicallyLoadedPart filename="i3d/bagSilo.i3d"         node="0" linkNode="bagSilo01"/>
        <dynamicallyLoadedPart filename="i3d/bagSilo.i3d"         node="0" linkNode="bagSilo02"/>
        <dynamicallyLoadedPart filename="i3d/siloBridge.i3d"      node="0" linkNode="siloBridge01"/>
        <dynamicallyLoadedPart filename="i3d/siloBridge.i3d"      node="0" linkNode="siloBridge02"/>
    </dynamicallyLoadedParts>

    <!-- Player dialog trigger at the shop entrance; vehicle unload + product
         spawn use the hall's own real nodes. -->
    <fertilizerDepot playerTrigger="playerTriggerMarker" unloadTrigger="unloadTriggerMarkerFertilizer" productSpawnMarker="palletSpawner"/>

    <!-- Map hotspot anchored at the vehicle unload zone -->
    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarkerFertilizer"/>
    </hotspots>

    <!-- In-world markers -->
    <triggerMarkers>
        <!-- Vehicle/trailer zone: park here to buy or sell -->
        <triggerMarker node="unloadTriggerMarkerFertilizer"
                       filename="$data/shared/assets/marker/markerIconLoad.i3d"
                       adjustToGround="true"/>
        <!-- Product output zone: bags/tanks spawn here -->
        <triggerMarker node="palletSpawner"
                       filename="$data/shared/assets/marker/markerIconPallet.i3d"
                       adjustToGround="true"/>
        <triggerMarker node="playerTriggerMarker"
                       filename="$data/shared/assets/marker/markerIconWrench.i3d"
                       adjustToGround="true"/>
        <triggerMarker node="warningStripes01"/>
    </triggerMarkers>

    <i3dMappings>
        <!-- Clear / level / paint areas -->
        <i3dMapping id="clearAreaStart01"  node="0>6|0"/>
        <i3dMapping id="clearAreaWidth01"  node="0>6|0|0"/>
        <i3dMapping id="clearAreaHeight01" node="0>6|0|1"/>

        <i3dMapping id="levelAreaStart01"  node="0>7|0"/>
        <i3dMapping id="levelAreaWidth01"  node="0>7|0|0"/>
        <i3dMapping id="levelAreaHeight01" node="0>7|0|1"/>

        <i3dMapping id="paintAreaStart01"  node="0>8|0"/>
        <i3dMapping id="paintAreaWidth01"  node="0>8|0|0"/>
        <i3dMapping id="paintAreaHeight01" node="0>8|0|1"/>

        <!-- Indoor area -->
        <i3dMapping id="indoorAreaStart01"  node="0>9|0"/>
        <i3dMapping id="indoorAreaWidth01"  node="0>9|0|0"/>
        <i3dMapping id="indoorAreaHeight01" node="0>9|0|1"/>

        <!-- Test areas -->
        <i3dMapping id="testAreaStart01" node="0>10|0"/>
        <i3dMapping id="testAreaEnd01"   node="0>10|0|0"/>

        <!-- Tip occlusion -->
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>11|0"/>
        <i3dMapping id="tipOcclusionUpdateAreaEnd01"   node="0>11|0|0"/>

        <!-- Dynamic parts -->
        <i3dMapping id="props"          node="0>4|0"/>
        <i3dMapping id="solarPanels"    node="0>4|1"/>
        <i3dMapping id="solar1"         node="0>4|1|0"/>
        <i3dMapping id="solar2"         node="0>4|1|1"/>
        <i3dMapping id="solar3"         node="0>4|1|2"/>
        <i3dMapping id="solar4"         node="0>4|1|3"/>
        <i3dMapping id="solar5"         node="0>4|1|4"/>
        <i3dMapping id="solar6"         node="0>4|1|5"/>
        <i3dMapping id="bagSilo01"      node="0>4|2|0"/>
        <i3dMapping id="bagSilo02"      node="0>4|2|1"/>
        <i3dMapping id="siloBridge01"   node="0>4|3|0"/>
        <i3dMapping id="siloBridge02"   node="0>4|3|1"/>

        <!-- Functional nodes (mod's own) -->
        <i3dMapping id="playerTriggerMarker"       node="0>16|0|0"/>
        <i3dMapping id="unloadTriggerMarkerFertilizer" node="0>13|1|3"/>
        <i3dMapping id="palletSpawner"             node="0>18"/>
        <i3dMapping id="warningStripes01"          node="0>15|0"/>
    </i3dMappings>

</placeable>
