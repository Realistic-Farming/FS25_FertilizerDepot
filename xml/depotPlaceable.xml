<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    depotPlaceable.xml
    Fertilizer Depot store building: the vendored industrial fertilizer
    production hall with its FULL machinery (production chains, selling,
    loading, buying, pallet buying, solar panels, billboards, levers, colors),
    plus the mod's own fertilizerDepot buy/store/sell system layered on top.
    The mod's functional nodes map onto the hall's real nodes:
      playerTrigger      -> playerTriggerMarker (0>16|0|0)
      unloadTrigger      -> unloadTriggerMarkerFertilizer (0>13|1|3)
      productSpawnMarker -> palletSpawner (0>18)
-->
<placeable type="fertilizerDepotType">

    <storeData>
        <name>$l10n_fd_shop_name</name>
        <functions>
            <function>$l10n_fd_shop_function</function>
        </functions>
        <image>icon.dds</image>
        <price>25000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/fertilizerProduction_chem.i3d</filename>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01"/>
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01"
                   heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="0" maxSlope="100" maxEdgeAngle="100">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01"
                       heightNode="levelAreaHeight01"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01"
                       heightNode="paintAreaHeight01" groundType="grass"/>
            <paintArea startNode="paintAreaStart02" widthNode="paintAreaWidth02"
                       heightNode="paintAreaHeight02" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart03" widthNode="paintAreaWidth03"
                       heightNode="paintAreaHeight03" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart04" widthNode="paintAreaWidth04"
                       heightNode="paintAreaHeight04" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart05" widthNode="paintAreaWidth05"
                       heightNode="paintAreaHeight05" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart06" widthNode="paintAreaWidth06"
                       heightNode="paintAreaHeight06" groundType="asphalt"/>
            <paintArea startNode="paintAreaStart07" widthNode="paintAreaWidth07"
                       heightNode="paintAreaHeight07" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <foliageAreas>
        <foliageArea startNode="foliageAreaStart01" widthNode="foliageAreaWidth01" heightNode="foliageAreaHeight01" decoFoliage="decoFoliageUS" fruitType="meadow"/>
        <foliageArea startNode="foliageAreaStart02" widthNode="foliageAreaWidth02" heightNode="foliageAreaHeight02" decoFoliage="decoFoliageUS" fruitType="meadow"/>
        <foliageArea startNode="foliageAreaStart03" widthNode="foliageAreaWidth03" heightNode="foliageAreaHeight03" decoFoliage="decoFoliageUS" fruitType="meadow"/>
        <foliageArea startNode="foliageAreaStart04" widthNode="foliageAreaWidth04" heightNode="foliageAreaHeight04" decoFoliage="decoFoliageUS" fruitType="meadow"/>
        <foliageArea startNode="foliageAreaStart05" widthNode="foliageAreaWidth05" heightNode="foliageAreaHeight05" decoFoliage="decoFoliageUS" fruitType="meadow"/>
    </foliageAreas>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="worldPosition" teleportNode="playerTriggerMarker"/>
        <hotspot type="UNLOADING" linkNode="exactFillNodeManure" teleportNode="exactFillNodeManure"/>
        <hotspot type="UNLOADING" linkNode="exactFillNodeFertilizer" teleportNode="exactFillNodeFertilizer"/>
        <hotspot type="LOADING" linkNode="loadingTriggerFertilizer" teleportNode="loadingTriggerFertilizer"/>
        <hotspot type="LOADING" linkNode="loadingTriggerBuying" teleportNode="loadingTriggerBuying"/>
        <hotspot type="SHOP" linkNode="palletBuyingActivationTriggerMarker" teleportNode="palletBuyingActivationTriggerMarker"/>
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="i3d/metalHall_props.i3d" node="0" linkNode="props"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d" node="0" linkNode="solar1"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d" node="0" linkNode="solar2"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d" node="0" linkNode="solar3"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d" node="0" linkNode="solar4"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d" node="0" linkNode="solar5"/>
        <dynamicallyLoadedPart filename="i3d/solarPanel.i3d" node="0" linkNode="solar6"/>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCoverWideGrid.i3d" node="0" linkNode="grainGate"/>
        <dynamicallyLoadedPart filename="i3d/bagSilo.i3d" node="0" linkNode="bagSilo01"/>
        <dynamicallyLoadedPart filename="i3d/bagSilo.i3d" node="0" linkNode="bagSilo02"/>
        <dynamicallyLoadedPart filename="i3d/siloBridge.i3d" node="0" linkNode="siloBridge01"/>
        <dynamicallyLoadedPart filename="i3d/siloBridge.i3d" node="0" linkNode="siloBridge02"/>
    </dynamicallyLoadedParts>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMarkerManure" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="unloadTriggerMarkerFertilizer" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="loadTriggerMarkerFertilizer" adjustToGround="true" filename="$data/shared/assets/marker/markerIconLoad.i3d"/>
        <triggerMarker node="loadTriggerMarkerBuying" adjustToGround="true" filename="$data/shared/assets/marker/markerIconLoad.i3d"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="palletBuyingActivationTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconShopping.i3d"/>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="warningStripes03"/>
        <triggerMarker node="warningStripes04"/>
    </triggerMarkers>

    <animatedObjects>
        <animatedObject saveId="leverSpawner1">
            <animation duration="1.0">
                <part node="lever01">
                    <keyFrame time="0.0" rotation="0 0 40"/>
                    <keyFrame time="1.0" rotation="0 0 -40"/>
                </part>
                <part node="informationBillboard01">
                    <keyFrame time="0.0" visibility="true"/>
                    <keyFrame time="1.0" visibility="false"/>
                </part>
            </animation>
            <controls triggerNode="leverTrigger01" posAction="ACTIVATE_HANDTOOL" posText="action_turnOnInformation" negText="action_turnOffInformation"/>
        </animatedObject>
        <animatedObject saveId="leverSpawner2">
            <animation duration="1.0">
                <part node="lever02">
                    <keyFrame time="0.0" rotation="0 0 40"/>
                    <keyFrame time="1.0" rotation="0 0 -40"/>
                </part>
                <part node="informationBillboard02">
                    <keyFrame time="0.0" visibility="true"/>
                    <keyFrame time="1.0" visibility="false"/>
                </part>
            </animation>
            <controls triggerNode="leverTrigger02" posAction="ACTIVATE_HANDTOOL" posText="action_turnOnBillboard" negText="action_turnOffBillboard"/>
        </animatedObject>
    </animatedObjects>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="fertilizer_ammonia" name="%s (%s + %s + %s)" params="$l10n_fillType_fertilizer|$l10n_fillType_ammonia|$l10n_fillType_phosphoricAcid|$l10n_fillType_potassiumChloride" cyclesPerHour="5" costsPerActiveHour="12">
                <inputs>
                    <input fillType="AMMONIA" amount="333"/>
                    <input fillType="PHOSPHORIC_ACID" amount="333"/>
                    <input fillType="POTASSIUM_CHLORIDE" amount="333"/>
                </inputs>
                <outputs>
                    <output fillType="FERTILIZER" amount="1000"/>
                </outputs>
            </production>
            <production id="fertilizer_urea" name="%s (%s + %s + %s)" params="$l10n_fillType_fertilizer|$l10n_fillType_urea|$l10n_fillType_phosphoricAcid|$l10n_fillType_potassiumChloride" cyclesPerHour="5" costsPerActiveHour="12">
                <inputs>
                    <input fillType="UREA" amount="333"/>
                    <input fillType="PHOSPHORIC_ACID" amount="333"/>
                    <input fillType="POTASSIUM_CHLORIDE" amount="333"/>
                </inputs>
                <outputs>
                    <output fillType="FERTILIZER" amount="1000"/>
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="AMMONIA" capacity="100000"/>
            <capacity fillType="PHOSPHORIC_ACID" capacity="100000"/>
            <capacity fillType="POTASSIUM_CHLORIDE" capacity="100000"/>
            <capacity fillType="UREA" capacity="100000"/>
            <capacity fillType="FERTILIZER" capacity="1000000"/>
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false" allowMissions="true">
            <unloadTrigger exactFillRootNode="exactFillNodeManure" aiNode="unloadTriggerAINodeManure" fillTypes="AMMONIA PHOSPHORIC_ACID UREA" allowMissions="true" stationName="$l10n_stationName_fertilizerChemIn"/>
            <palletTrigger triggerNode="palletTriggerManure" aiNode="unloadTriggerAINodeManure" fillTypes="AMMONIA PHOSPHORIC_ACID UREA"/>
            <baleTrigger triggerNode="baleTriggerManure" aiNode="unloadTriggerAINodeManure" fillTypes="AMMONIA PHOSPHORIC_ACID UREA"/>
            <unloadTrigger exactFillRootNode="exactFillNodeFertilizer" aiNode="unloadTriggerAINodeManure" fillTypes="FERTILIZER POTASSIUM_CHLORIDE" allowMissions="false" stationName="$l10n_stationName_fertilizerManureChemIn"/>
            <palletTrigger triggerNode="palletTriggerFertilizer" aiNode="unloadTriggerAINodeManure" fillTypes="FERTILIZER POTASSIUM_CHLORIDE"/>
            <baleTrigger triggerNode="baleTriggerFertilizer" aiNode="unloadTriggerAINodeManure" fillTypes="FERTILIZER POTASSIUM_CHLORIDE"/>
        </sellingStation>

        <loadingStation node="loadingStation" supportsExtension="false">
            <loadTrigger triggerNode="loadingTriggerFertilizer" fillLitersPerSecond="1000" dischargeNode="dischargeNodeFertilizer" fillTypes="FERTILIZER" stationName="$l10n_stationName_fertilizerCemStorageOut" aiNode="loadTriggerAINodeFertilizer" autoStart="true">
                <effectNode effectClass="PipeEffect" effectNode="pipeEffectFertilizer" materialType="pipe" fadeTime="0.5" maxBending="0" shapeScaleSpread="1 1 1 0" controlPoint="7.25 0 0 0"/>
                <effectNode effectNode="pipeEffectSmokeFertilizer" materialType="unloadingSmoke" fadeTime="0.5"/>
            </loadTrigger>
        </loadingStation>

        <playerTrigger node="playerTrigger"/>
        <sounds>
            <idle template="placeableSmallIdleGeneric" linkNode="0>"/>
            <active template="feedingRobotLoop" linkNode="0>"/>
        </sounds>
    </productionPoint>

    <buyingStation node="buyingStation" supportsExtension="false">
        <loadTrigger triggerNode="loadingTriggerBuying" fillTypes="FERTILIZER POTASSIUM_CHLORIDE" fillLitersPerSecond="1000" infiniteCapacity="true" stationName="$l10n_stationName_fertilizerChemBuying" aiNode="loadTriggerAINodeBuying" autoStart="false">
            <effectNode effectClass="PipeEffect" effectNode="pipeEffectBuying" materialType="pipe" fadeTime="0.5" maxBending="0" shapeScaleSpread="0.8 0.8 1 0" controlPoint="3 0 0 0"/>
            <effectNode effectNode="pipeEffectSmokeBuying" materialType="unloadingSmoke" fadeTime="0.5"/>
        </loadTrigger>
        <loadTrigger triggerNode="loadingTriggerBuyingChem" fillTypes="AMMONIA PHOSPHORIC_ACID UREA" fillLitersPerSecond="1000" infiniteCapacity="true" aiNode="loadTriggerAINodeBuying" autoStart="false"/>
        <fillType name="FERTILIZER" priceScale="1"/>
        <fillType name="AMMONIA" priceScale="1"/>
        <fillType name="PHOSPHORIC_ACID" priceScale="1"/>
        <fillType name="POTASSIUM_CHLORIDE" priceScale="1"/>
        <fillType name="UREA" priceScale="1"/>
    </buyingStation>

    <palletBuyingStation triggerNode="palletBuyingActivationTrigger">
        <fillType name="FERTILIZER" priceScale="1"/>
        <fillType name="AMMONIA" priceScale="1"/>
        <fillType name="PHOSPHORIC_ACID" priceScale="1"/>
        <fillType name="POTASSIUM_CHLORIDE" priceScale="1"/>
        <fillType name="UREA" priceScale="1"/>
        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" palletRotationOffset="0" maxLength="10"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02" palletRotationOffset="0" maxLength="10"/>
            </spawnPlaces>
        </palletSpawner>
    </palletBuyingStation>

    <colorConfigurations defaultColorIndex="14" useDefaultColors="false">
        <material slotName="metalWall"/>
        <colorConfiguration color="RUDOLFHOERMANN_GREEN"/>
        <colorConfiguration color="RUDOLFHOERMANN_BEIGE"/>
        <colorConfiguration color="RUDOLFHOERMANN_RED"/>
        <colorConfiguration color="RUDOLFHOERMANN_BLUE"/>
        <colorConfiguration color="RUDOLFHOERMANN_DARKGREY"/>
        <colorConfiguration color="RUDOLFHOERMANN_LIGHTGREY"/>
        <colorConfiguration color="RUDOLFHOERMANN_WHITEALU"/>
        <colorConfiguration color="RUDOLFHOERMANN_GREYALU"/>
        <colorConfiguration color="RUDOLFHOERMANN_OXIDRED"/>
        <colorConfiguration color="RUDOLFHOERMANN_WOODDARK"/>
        <colorConfiguration color="RUDOLFHOERMANN_WOODBRIGHT"/>
        <colorConfiguration color="RUDOLFHOERMANN_LIGHTGREEN"/>
        <colorConfiguration color="RUDOLFHOERMANN_DARKBEIGE"/>
    </colorConfigurations>

    <solarPanels>
        <solarPanelsConfigurations title="$l10n_configuration_name">
            <solarPanelsConfiguration name="$l10n_extras_nothing" isActive="false">
                <objectChange node="solarPanels" visibilityActive="false"/>
                <objectChange node="billboard" visibilityActive="false"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_extras_solar" isActive="true" price="55000" incomePerHour="75">
                <objectChange node="solarPanels" visibilityActive="true"/>
                <objectChange node="billboard" visibilityActive="false"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_extras_billboard" isActive="true" price="5000" incomePerHour="25">
                <objectChange node="solarPanels" visibilityActive="false"/>
                <objectChange node="billboard" visibilityActive="true"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_extras_both" isActive="true" price="60000" incomePerHour="100">
                <objectChange node="solarPanels" visibilityActive="true"/>
                <objectChange node="billboard" visibilityActive="true"/>
            </solarPanelsConfiguration>
        </solarPanelsConfigurations>
    </solarPanels>

    <!-- The mod's own fertilizerDepot system layered on the production hall -->
    <fertilizerDepot playerTrigger="playerTriggerMarker" unloadTrigger="unloadTriggerMarkerFertilizer" productSpawnMarker="palletSpawner"/>

