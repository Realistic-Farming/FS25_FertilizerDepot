<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    depotPlaceable.xml
    Fertilizer Depot store building. Uses the base-game brandless/farmerKioskBig
    shop (a walk-in supply kiosk, not the farmers market). The kiosk carries the
    real functional marker nodes the mod needs built in:
      playerTrigger      -> palletTrigger (0>8|1, the shop interior/front zone)
      unloadTrigger      -> unloadTriggerMarker (0>8|2, the vehicle unload zone)
      productSpawnMarker -> palletTrigger (0>8|1, product output zone)
    The kiosk's own clear/level/paint/indoor/test/tip-occlusion areas are used.
-->
<placeable type="fertilizerDepotType">

    <storeData>
        <name>$l10n_fd_shop_name</name>
        <functions>
            <function>$l10n_fd_shop_function</function>
        </functions>
        <image>icon.dds</image>
        <price>25000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/placeables/brandless/farmerKioskBig/farmerKioskBig.i3d</filename>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01"/>
        </testAreas>
        <sounds>
            <place template="medImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01"
                   heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01"
                       heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01"
                       heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02"/>
    </indoorAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01"
                                endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <lights>
        <group weatherRequiredFlags="NIGHT"/>
        <sharedLight linkNode="linkNode01" filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode02" filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode03" filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode04" filename="$data/shared/assets/lights/lizard/buildings/industrialLight05.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode05" filename="$data/shared/assets/lights/lizard/buildings/industrialLight05.xml" groupIndex="1"/>
        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <!-- Player dialog trigger at the shop front; vehicle unload + product spawn
         use the kiosk's own real nodes. -->
    <fertilizerDepot playerTrigger="palletTrigger" unloadTrigger="unloadTriggerMarker" productSpawnMarker="palletTrigger"/>

    <!-- Map hotspot anchored at the vehicle unload zone -->
    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker"/>
    </hotspots>

    <!-- In-world markers -->
    <triggerMarkers>
        <!-- Vehicle/trailer zone: park here to buy or sell -->
        <triggerMarker node="unloadTriggerMarker"
                       filename="$data/shared/assets/marker/markerIconLoad.i3d"
                       adjustToGround="true"/>
        <!-- Product output zone: bags/tanks spawn here -->
        <triggerMarker node="palletTrigger"
                       filename="$data/shared/assets/marker/markerIconPallet.i3d"
                       adjustToGround="true"/>
        <triggerMarker node="warningStripes01"/>
    </triggerMarkers>

    <i3dMappings>
        <!-- Clear / level / paint areas (kiosk asset) -->
        <i3dMapping id="clearAreaStart01"  node="0>0|0"/>
        <i3dMapping id="clearAreaWidth01"  node="0>0|0|0"/>
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1"/>

        <i3dMapping id="levelAreaStart01"  node="0>1|0"/>
        <i3dMapping id="levelAreaWidth01"  node="0>1|0|0"/>
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1"/>

        <i3dMapping id="paintAreaStart01"  node="0>2|0"/>
        <i3dMapping id="paintAreaWidth01"  node="0>2|0|0"/>
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1"/>

        <!-- Indoor areas -->
        <i3dMapping id="indoorAreaStart01"  node="0>3|0"/>
        <i3dMapping id="indoorAreaWidth01"  node="0>3|0|0"/>
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1"/>
        <i3dMapping id="indoorAreaStart02"  node="0>3|1"/>
        <i3dMapping id="indoorAreaWidth02"  node="0>3|1|0"/>
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1"/>

        <!-- Test areas -->
        <i3dMapping id="testAreaStart01" node="0>4|0"/>
        <i3dMapping id="testAreaEnd01"   node="0>4|0|0"/>

        <!-- Tip occlusion -->
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0"/>
        <i3dMapping id="tipOcclusionUpdateAreaEnd01"   node="0>5|0|0"/>

        <!-- Lights -->
        <i3dMapping id="realLightsLow"  node="0>7|0|0"/>
        <i3dMapping id="realLightsHigh" node="0>7|0|1"/>
        <i3dMapping id="linkNode01" node="0>7|1|0"/>
        <i3dMapping id="linkNode02" node="0>7|1|1"/>
        <i3dMapping id="linkNode03" node="0>7|1|2"/>
        <i3dMapping id="linkNode04" node="0>7|1|3"/>
        <i3dMapping id="linkNode05" node="0>7|1|4"/>

        <!-- Functional nodes (mod's own) -->
        <i3dMapping id="palletTrigger"       node="0>8|1"/>
        <i3dMapping id="unloadTriggerMarker" node="0>8|2"/>
    </i3dMappings>

</placeable>
